<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Clifford Kai | Graphic Design & AI Services</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      background: #f5f7fb;
      color: #222;
      line-height: 1.6;
    }

    header {
      background: #111827;
      color: white;
      padding: 20px;
      text-align: center;
    }

    header h1 {
      font-size: 30px;
      margin-bottom: 5px;
    }

    header p {
      color: #d1d5db;
    }

    nav {
      background: #1f2937;
      padding: 12px;
      text-align: center;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin: 0 10px;
      font-size: 14px;
    }

    .hero {
      background: linear-gradient(135deg, #2563eb, #7c3aed);
      color: white;
      padding: 70px 20px;
      text-align: center;
    }

    .hero h2 {
      font-size: 38px;
      margin-bottom: 15px;
    }

    .hero p {
      max-width: 600px;
      margin: auto;
      font-size: 17px;
    }

    .button {
      display: inline-block;
      margin-top: 25px;
      padding: 13px 25px;
      background: white;
      color: #2563eb;
      text-decoration: none;
      border-radius: 30px;
      font-weight: bold;
    }

    section {
      padding: 50px 20px;
      max-width: 1000px;
      margin: auto;
    }

    .title {
      text-align: center;
      margin-bottom: 30px;
    }

    .title h2 {
      font-size: 28px;
    }

    .services {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
    }

    .card {
      background: white;
      padding: 25px;
      border-radius: 15px;
      box-shadow: 0 5px 20px rgba(0,0,0,0.08);
      text-align: center;
    }

    .card .icon {
      font-size: 40px;
      margin-bottom: 10px;
    }

    .card h3 {
      margin-bottom: 10px;
    }

    .about {
      background: white;
      border-radius: 15px;
      padding: 30px;
      text-align: center;
    }

    .contact {
      text-align: center;
    }

    .contact a {
      display: inline-block;
      margin: 8px;
      padding: 12px 20px;
      background: #2563eb;
      color: white;
      text-decoration: none;
      border-radius: 8px;
    }

    footer {
      background: #111827;
      color: white;
      text-align: center;
      padding: 25px;
      margin-top: 30px;
    }

    @media (max-width: 600px) {
      .hero h2 {
        font-size: 30px;
      }

      nav a {
        margin: 0 5px;
      }
    }
  </style>
</head>

<body>

  <header>
    <h1>Clifford Kai</h1>
    <p>Graphic Design & AI Services</p>
  </header>

  <nav>
    <a href="#home">Home</a>
    <a href="#services">Services</a>
    <a href="#about">About</a>
    <a href="#contact">Contact</a>
  </nav>

  <section class="hero" id="home">
    <h2>Creative Designs. Powerful AI.</h2>
    <p>
      Welcome to Clifford Kai — professional graphic design and AI-powered
      creative services for individuals, businesses and content creators.
    </p>
    <a class="button" href="#contact">Get Started</a>
  </section>

  <section id="services">
    <div class="title">
      <h2>My Services</h2>
      <p>Creative solutions for your digital needs.</p>
    </div>

    <div class="services">

      <div class="card">
        <div class="icon">🎨</div>
        <h3>Graphic Design</h3>
        <p>
          Posters, flyers, banners, social media graphics and promotional designs.
        </p>
      </div>

      <div class="card">
        <div class="icon">🤖</div>
        <h3>AI Image Creation</h3>
        <p>
          Creative AI-generated images, concepts, portraits and promotional visuals.
        </p>
      </div>

      <div class="card">
        <div class="icon">📱</div>
        <h3>Social Media Design</h3>
        <p>
          Eye-catching content designed for Facebook, Instagram, TikTok and other platforms.
        </p>
      </div>

      <div class="card">
        <div class="icon">✨</div>
        <h3>Photo Enhancement</h3>
        <p>
          Improve your photos with high-quality enhancement and creative editing.
        </p>
      </div>

    </div>
  </section>

  <section id="about">
    <div class="title">
      <h2>About Clifford Kai</h2>
    </div>

    <div class="about">
      <p>
        I am Clifford Kai, a creative designer passionate about graphic design,
        AI creativity and digital content. My goal is to help people and
        businesses turn ideas into attractive visual content.
      </p>
    </div>
  </section>

  <section id="contact" class="contact">
    <div class="title">
      <h2>Let's Work Together</h2>
      <p>Have a design project or AI image idea?</p>
    </div>

    <a href="https://wa.me/265XXXXXXXXX">💬 WhatsApp Me</a>
    <a href="mailto:your@email.com">📧 Email Me</a>
  </section>

  <footer>
    <p>© 2026 Clifford Kai. All Rights Reserved.</p>
    <p>Graphic Design • AI Services • Creative Content</p>
  </footer>

</body>
</html>
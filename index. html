<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta name="viewport"
        content="width=device-width, initial-scale=1.0">

  <meta name="description"
        content="Clifford Kai - Personal blog about AI, technology, content creation, fashion and digital skills.">

  <meta name="author" content="Clifford Kai">

  <title>Clifford Kai | My Personal Blog</title>

  <style>
    /* =========================
       GENERAL STYLES
    ========================== */

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #f5f7fb;
      color: #222;
      line-height: 1.6;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    img {
      max-width: 100%;
      display: block;
    }

    .container {
      width: 90%;
      max-width: 1100px;
      margin: auto;
    }

    /* =========================
       HEADER
    ========================== */

    header {
      background: #111827;
      color: white;
      position: sticky;
      top: 0;
      z-index: 1000;
      box-shadow: 0 3px 15px rgba(0,0,0,0.15);
    }

    .navbar {
      min-height: 70px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      font-size: 1.5rem;
      font-weight: 800;
      letter-spacing: 0.5px;
    }

    .logo span {
      color: #22c55e;
    }

    nav {
      display: flex;
      gap: 25px;
    }

    nav a {
      color: white;
      font-size: 0.95rem;
      transition: 0.3s;
    }

    nav a:hover {
      color: #22c55e;
    }

    /* =========================
       HERO
    ========================== */

    .hero {
      min-height: 88vh;
      display: flex;
      align-items: center;
      background:
        linear-gradient(135deg, #111827, #1e293b);
      color: white;
      padding: 70px 0;
    }

    .hero-content {
      max-width: 760px;
    }

    .tag {
      display: inline-block;
      background: rgba(34,197,94,0.15);
      color: #4ade80;
      padding: 8px 15px;
      border-radius: 30px;
      margin-bottom: 20px;
      font-size: 0.9rem;
      font-weight: bold;
    }

    .hero h1 {
      font-size: clamp(2.5rem, 7vw, 5rem);
      line-height: 1.05;
      margin-bottom: 20px;
    }

    .hero h1 span {
      color: #22c55e;
    }

    .hero p {
      font-size: 1.15rem;
      color: #d1d5db;
      max-width: 680px;
      margin-bottom: 30px;
    }

    .buttons {
      display: flex;
      gap: 15px;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-block;
      padding: 13px 23px;
      border-radius: 8px;
      font-weight: bold;
      transition: 0.3s;
    }

    .btn-primary {
      background: #22c55e;
      color: #062e16;
    }

    .btn-primary:hover {
      background: #4ade80;
      transform: translateY(-2px);
    }

    .btn-outline {
      border: 1px solid #64748b;
      color: white;
    }

    .btn-outline:hover {
      border-color: #22c55e;
      color: #4ade80;
    }

    /* =========================
       SECTIONS
    ========================== */

    section {
      padding: 80px 0;
    }

    .section-title {
      text-align: center;
      margin-bottom: 45px;
    }

    .section-title h2 {
      font-size: 2.2rem;
      margin-bottom: 10px;
    }

    .section-title p {
      color: #64748b;
    }

    /* =========================
       ABOUT
    ========================== */

    .about {
      background: white;
    }

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 45px;
      align-items: center;
    }

    .about-text h3 {
      font-size: 1.8rem;
      margin-bottom: 15px;
    }

    .about-text p {
      color: #4b5563;
      margin-bottom: 15px;
    }

    .about-box {
      background: #f1f5f9;
      padding: 30px;
      border-radius: 15px;
      border-left: 5px solid #22c55e;
    }

    .about-box h3 {
      margin-bottom: 15px;
    }

    /* =========================
       TOPICS
    ========================== */

    .topics {
      background: #f5f7fb;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
    }

    .card {
      background: white;
      padding: 30px;
      border-radius: 15px;
      box-shadow: 0 8px 25px rgba(15,23,42,0.07);
      transition: 0.3s;
    }

    .card:hover {
      transform: translateY(-7px);
      box-shadow: 0 15px 35px rgba(15,23,42,0.12);
    }

    .icon {
      font-size: 2.2rem;
      margin-bottom: 15px;
    }

    .card h3 {
      margin-bottom: 10px;
    }

    .card p {
      color: #64748b;
    }

    /* =========================
       BLOG
    ========================== */

    .blog {
      background: white;
    }

    .blog-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
    }

    .post {
      border: 1px solid #e5e7eb;
      border-radius: 15px;
      overflow: hidden;
      background: white;
      transition: 0.3s;
    }

    .post:hover {
      transform: translateY(-5px);
    }

    .post-image {
      height: 170px;
      background: linear-gradient(135deg, #1e293b, #22c55e);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 3rem;
    }

    .post-content {
      padding: 22px;
    }

    .post-content small {
      color: #22a653;
      font-weight: bold;
    }

    .post-content h3 {
      margin: 8px 0;
    }

    .post-content p {
      color: #64748b;
      font-size: 0.95rem;
    }

    /* =========================
       SKILLS
    ========================== */

    .skills {
      background: #f5f7fb;
    }

    .skills-list {
      max-width: 800px;
      margin: auto;
    }

    .skill {
      margin-bottom: 20px;
    }

    .skill-header {
      display: flex;
      justify-content: space-between;
      margin-bottom: 7px;
      font-weight: bold;
    }

    .progress {
      height: 10px;
      background: #e2e8f0;
      border-radius: 20px;
      overflow: hidden;
    }

    .progress-bar {
      height: 100%;
      background: #22c55e;
      border-radius: 20px;
    }

    /* =========================
       CONTACT
    ========================== */

    .contact {
      background: #111827;
      color: white;
      text-align: center;
    }

    .contact h2 {
      font-size: 2.3rem;
      margin-bottom: 15px;
    }

    .contact p {
      color: #cbd5e1;
      max-width: 650px;
      margin: 0 auto 30px;
    }

    .socials {
      display: flex;
      justify-content: center;
      gap: 15px;
      flex-wrap: wrap;
    }

    .social {
      border: 1px solid #475569;
      padding: 10px 18px;
      border-radius: 8px;
      transition: 0.3s;
    }

    .social:hover {
      border-color: #22c55e;
      color: #4ade80;
    }

    /* =========================
       FOOTER
    ========================== */

    footer {
      background: #020617;
      color: #94a3b8;
      text-align: center;
      padding: 25px;
      font-size: 0.9rem;
    }

    footer strong {
      color: white;
    }

    /* =========================
       MOBILE
    ========================== */

    @media (max-width: 800px) {

      nav {
        display: none;
      }

      .hero {
        min-height: 80vh;
      }

      .about-grid {
        grid-template-columns: 1fr;
      }

      .cards,
      .blog-grid {
        grid-template-columns: 1fr;
      }

      section {
        padding: 60px 0;
      }

      .hero p {
        font-size: 1rem;
      }

      .hero h1 {
        font-size: 3rem;
      }
    }
  </style>
</head>


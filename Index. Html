<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Kai Tech | AI & Graphics Designs</title>

  <meta name="description" content="Kai Tech - AI solutions, graphics designs and digital technology services.">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, sans-serif;
      background: #0b1020;
      color: white;
      line-height: 1.6;
    }

    header {
      background: #111936;
      padding: 20px 8%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 1000;
    }

    .logo {
      font-size: 25px;
      font-weight: bold;
      color: #00d9ff;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin-left: 20px;
      font-weight: bold;
    }

    nav a:hover {
      color: #00d9ff;
    }

    .hero {
      min-height: 90vh;
      display: flex;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 40px 8%;
      background: linear-gradient(135deg, #0b1020, #172554);
    }

    .hero h1 {
      font-size: 55px;
      margin-bottom: 15px;
    }

    .hero h1 span {
      color: #00d9ff;
    }

    .hero p {
      font-size: 20px;
      max-width: 700px;
      margin: auto;
      color: #d7dbea;
    }

    .button {
      display: inline-block;
      margin-top: 30px;
      padding: 14px 28px;
      background: #00d9ff;
      color: #06101c;
      text-decoration: none;
      border-radius: 30px;
      font-weight: bold;
    }

    section {
      padding: 80px 8%;
    }

    .section-title {
      text-align: center;
      font-size: 35px;
      margin-bottom: 40px;
      color: #00d9ff;
    }

    .services {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 25px;
    }

    .card {
      background: #151d38;
      padding: 30px;
      border-radius: 15px;
      text-align: center;
      border: 1px solid #26345f;
    }

    .card h3 {
      color: #00d9ff;
      margin-bottom: 15px;
      font-size: 23px;
    }

    .card p {
      color: #d7dbea;
    }

    .about {
      max-width: 850px;
      margin: auto;
      text-align: center;
      color: #d7dbea;
      font-size: 18px;
    }

    .contact {
      text-align: center;
      background: #111936;
    }

    .contact-box {
      max-width: 600px;
      margin: auto;
      background: #151d38;
      padding: 30px;
      border-radius: 15px;
    }

    .contact-box p {
      margin: 15px 0;
      font-size: 18px;
    }

    .contact-box a {
      color: #00d9ff;
      text-decoration: none;
      font-weight: bold;
    }

    footer {
      text-align: center;
      padding: 25px;
      background: #070b17;
      color: #9da5bd;
    }

    @media (max-width: 700px) {
      header {
        flex-direction: column;
        gap: 15px;
      }

      nav a {
        margin: 0 7px;
        font-size: 14px;
      }

      .hero h1 {
        font-size: 40px;
      }
    }
  </style>
</head>

<body>

  <header>
    <div class="logo">KAI TECH</div>

    <nav>
      <a href="#home">Home</a>
      <a href="#services">Services</a>
      <a href="#about">About</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <section class="hero" id="home">
    <div>
      <h1>Welcome to <span>Kai Tech</span></h1>

      <p>
        AI Solutions • Graphics Designs • Digital Technology
      </p>

      <a href="#contact" class="button">Contact Me</a>
    </div>
  </section>

  <section id="services">
    <h2 class="section-title">My Services</h2>

    <div class="services">

      <div class="card">
        <h3>🤖 AI</h3>
        <p>
          AI-powered ideas, digital solutions and creative technology projects.
        </p>
      </div>

      <div class="card">
        <h3>🎨 Graphics Design</h3>
        <p>
          Creative graphics, posters, branding, social media designs and visual content.
        </p>
      </div>

      <div class="card">
        <h3>💻 Technology</h3>
        <p>
          Websites, digital projects and technology solutions for individuals and businesses.
        </p>
      </div>

    </div>
  </section>

  <section id="about">
    <h2 class="section-title">About Kai Tech</h2>

    <div class="about">
      <p>
        Kai Tech is a creative technology brand focused on Artificial Intelligence,
        graphics design and digital solutions. The goal is to combine creativity
        and technology to build useful and innovative digital experiences.
      </p>
    </div>
  </section>

  <section class="contact" id="contact">
    <h2 class="section-title">Contact Me</h2>

    <div class="contact-box">

      <p>
        📘 Facebook:
        <a href="https://www.facebook.com/Cliffordkai" target="_blank">
          Cliffordkai
        </a>
      </p>

      <p>
        📧 Email:
        <a href="mailto:cliffordkameme6@gmail.com">
          cliffordkameme6@gmail.com
        </a>
      </p>

    </div>
  </section>

  <footer>
    <p>© 2026 Kai Tech. All Rights Reserved.</p>
  </footer>

</body>
</html>
